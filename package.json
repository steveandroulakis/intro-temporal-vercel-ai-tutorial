{
  "name": "intro-temporal-vercel-tutorial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "start": "ts-node src/worker.ts",
    "start:watch": "nodemon src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "start:ai": "ts-node -r dotenv/config src/ai-worker.ts",
    "start:ai:watch": "nodemon -r dotenv/config src/ai-worker.ts",
    "workflow:ai:haiku": "ts-node src/ai-client.ts haiku",
    "workflow:ai:tools": "ts-node src/ai-client.ts tools"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@temporalio/activity": "^1.14.1",
    "@temporalio/client": "^1.14.1",
    "@temporalio/envconfig": "^1.14.1",
    "@temporalio/worker": "^1.14.1",
    "@temporalio/workflow": "^1.14.1",
    "@temporalio/ai-sdk": "^1.14.1",
    "@sap/ai-sdk-vercel-adapter": "file:sap-ai-sdk-vercel-adapter-0.2.0.tgz",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0",
    "dotenv": "^17.2.3",
    "nanoid": "3.x",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^22.9.1",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
